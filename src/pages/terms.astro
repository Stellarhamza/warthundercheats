---
import BaseLayout from '../layouts/BaseLayout.astro'
import { PolicyPage } from '../views/PolicyPage'
import { SITE_URL } from '../data/site'
import { getPolicyPage } from '../data/policies'
import { PAGE_OG } from '../data/og'

const page = getPolicyPage('terms')!
const seo = {
  title: page.title,
  description: page.description,
  path: page.path,
  ogType: 'website' as const,
  image: PAGE_OG.terms,
  imageAlt: 'War Thunder Cheats terms of use',
  robots: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
}

const jsonLdExtra = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Terms', item: `${SITE_URL}/terms` },
    ],
  },
]
---

<BaseLayout seo={seo} jsonLdExtra={jsonLdExtra}>
  <PolicyPage client:visible page={page} />
</BaseLayout>
