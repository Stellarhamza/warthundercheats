---
import BaseLayout from '../layouts/BaseLayout.astro'
import { NotFoundPage } from '../views/NotFoundPage'
import { SITE_NAME, OG_IMAGE, type PageSeo } from '../data/site'

const seo: PageSeo = {
  title: `Page Not Found | ${SITE_NAME}`,
  description: `This page was not found. Browse War Thunder Cheats guides instead.`,
  path: '/404',
  image: OG_IMAGE,
  robots: 'noindex, follow',
  ogType: 'website',
}
---

<BaseLayout seo={seo}>
  <NotFoundPage client:visible />
</BaseLayout>

