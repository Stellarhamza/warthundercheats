---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { BlogPostPage } from '../../views/BlogPostPage'
import { BLOGS, blogPath, getBlog } from '../../data/blogs'
import { SITE_URL, type PageSeo } from '../../data/site'
import { getForumMedia } from '../../data/media'

export function getStaticPaths() {
  return BLOGS.map((post) => ({
    params: { slug: post.slug },
  }))
}

const { slug } = Astro.params
const post = getBlog(slug!)

if (!post) {
  return Astro.redirect('/404')
}

const media = getForumMedia(post.slug)
const absoluteMedia = (path: string) => `${SITE_URL}${path}`
const ogImage = `/og/forums-${post.slug}.jpg`
const pageUrl = `${SITE_URL}${blogPath(post.slug)}`

const seo: PageSeo = {
  title: post.metaTitle,
  description: post.metaDescription,
  path: blogPath(post.slug),
  ogType: 'article',
  image: ogImage,
  imageAlt: `${post.title} — War Thunder Cheats guide`,
  robots: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
}

const howToLd = post.howTo
  ? {
      '@type': 'HowTo',
      name: post.title,
      description: post.metaDescription,
      totalTime: `PT${post.readMinutes}M`,
      image: absoluteMedia(ogImage),
      step: post.sections.map((section, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: section.heading,
        text: section.body.join(' '),
        url: `${pageUrl}#${section.heading
          .replace(/^\d+\)\s*/, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '')}`,
      })),
    }
  : null

const jsonLdExtra = [
  {
    '@type': 'BlogPosting',
    headline: post.title,
    alternativeHeadline: post.metaTitle,
    description: post.metaDescription,
    datePublished: post.date,
    dateModified: post.date,
    author: { '@id': `${SITE_URL}/#organization` },
    publisher: { '@id': `${SITE_URL}/#organization` },
    mainEntityOfPage: pageUrl,
    isPartOf: { '@id': `${SITE_URL}/forums#webpage` },
    image: {
      '@type': 'ImageObject',
      url: absoluteMedia(ogImage),
      width: 1200,
      height: 630,
      name: post.title,
      caption: post.metaDescription,
    },
    thumbnailUrl: absoluteMedia(ogImage),
    inLanguage: 'en',
    articleSection: post.tag,
  },
  ...(howToLd ? [howToLd] : []),
  ...(media.video
    ? [
        {
          '@type': 'VideoObject',
          name: media.videoTitle || media.title,
          description: media.videoDescription || media.caption,
          thumbnailUrl: absoluteMedia('/media/wt-video-thumb.jpg'),
          contentUrl: absoluteMedia(media.video),
          uploadDate: post.date,
          isFamilyFriendly: true,
        },
      ]
    : []),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'War Thunder Cheats Guides',
        item: `${SITE_URL}/forums`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.title,
        item: pageUrl,
      },
    ],
  },
]
---

<BaseLayout seo={seo} jsonLdExtra={jsonLdExtra}>
  <BlogPostPage client:visible slug={post.slug} />
</BaseLayout>
